# ─── Application ───────────────────────────────────────────
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://crypto:crypto@localhost:5432/crypto_analysis

# ─── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ─── Exchange Provider ─────────────────────────────────────
# Set to "demo" to use deterministic demo data without keys
EXCHANGE_PROVIDER=demo
# EXCHANGE_PROVIDER=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com

# ─── AI Provider ───────────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Budget: max AI calls per day
AI_DAILY_BUDGET=100

# ─── News Provider ─────────────────────────────────────────
NEWS_PROVIDER=demo
# NEWS_PROVIDER=cryptopanic
CRYPTOPANIC_API_KEY=

# ─── CoinGecko (metadata only) ─────────────────────────────
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ─── MCP Outbound Client (ChatGPT MCP server) ──────────────
MCP_SERVER_URL=
MCP_SERVER_TOKEN=
MCP_TRANSPORT=sse

# ─── Platform MCP Server ───────────────────────────────────
MCP_PLATFORM_PORT=3002
MCP_PLATFORM_SECRET=change_me

# ─── Quant Service ─────────────────────────────────────────
QUANT_SERVICE_URL=http://localhost:8001

# ─── Web Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── API Server ────────────────────────────────────────────
API_PORT=3001

# ─── Stale / Heartbeat Thresholds ──────────────────────────
QUOTE_STALE_SECONDS=15
CANDLE_STALE_SECONDS=30

# ─── S3-Compatible Storage (optional) ─────────────────────
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# ─── Timezone ──────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Colombo
